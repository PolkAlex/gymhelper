{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "permission": {
    "edit": "allow",
    "bash": { "*": "allow" },
    "webfetch": "allow",
    "external_directory": { "*": "allow" }
  },
  "provider": {
    "zai": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4"
      }
    }
  },
  "mcp_servers": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.85", "--headless"],
      "enable": ["lead", "design", "coder", "reviewer", "tester"]
    }
  }
}
